{
  "format": "camping-editor-presets-v2",
  "target": "Jianying editable text objects",
  "units": "All font sizes and percentages below are Jianying UI control values; verify native field mapping in the installed version.",
  "usage": "Fill episode facts and timeline ranges in intro-plan.json. Apply these profiles to independent native text objects. This is not a renderer timeline or native draft JSON.",
  "animation": {
    "entrance": "fade_in",
    "entrance_seconds": 0.8,
    "exit": "fade_out",
    "exit_seconds": 0.5,
    "position_static": true,
    "scale_static": true,
    "across_cuts": "one continuous text object; animate only at the start and end"
  },
  "profiles": {
    "intro": {
      "font_family": "Montserrat",
      "font_weight": "Regular",
      "font_size": 10,
      "scale_percent_range": [
        40,
        55
      ],
      "color": "#FFFFFF",
      "background": {
        "enabled": false
      },
      "shadow": {
        "enabled": true,
        "opacity_percent": null,
        "blur": null,
        "adjustment": "Tune opacity and blur against bright and dark footage; record actual UI values."
      },
      "missing_chinese_glyphs": "Use system Chinese Regular for missing Chinese glyphs and record actual font families."
    },
    "diary": {
      "font_family": "system Chinese Regular",
      "macos_font_family": "PingFang SC Regular",
      "font_size": 10,
      "scale_percent": 40,
      "color": "#FFFFFF",
      "background": {
        "enabled": true,
        "color": "#000000",
        "opacity_percent": 65,
        "corner_radius_percent": 6,
        "height_percent": 10,
        "width_percent": 15
      },
      "position": "bottom safe area, horizontally centered"
    }
  },
  "modules": {
    "highlights": {
      "required": true,
      "video_track": "main",
      "start_seconds": 0,
      "text": "IN THIS EPISODE...",
      "profile": "intro",
      "position": "frame_center_horizontal_and_vertical",
      "text_range": "entire highlight montage"
    },
    "episode_intro": {
      "required": true,
      "video_track": "main",
      "placement": "early body footage after highlights",
      "profile": "intro",
      "information_groups": [
        {
          "kind": "theme",
          "required": true,
          "languages": [
            "zh",
            "en"
          ]
        },
        {
          "kind": "camp_or_location",
          "required": true,
          "languages": [
            "zh",
            "en"
          ]
        },
        {
          "kind": "weather_or_conditions",
          "required": "when relevant to this episode",
          "languages": [
            "zh",
            "en"
          ]
        }
      ],
      "missing_required_facts": "Ask the user together; continue independent editing while awaiting the answer. Keep the affected introduction pending."
    },
    "object_note": {
      "required": false,
      "profile": "intro",
      "placement": "safe space beside the relevant object"
    },
    "diary": {
      "required": "when narration serves the episode",
      "profile": "diary",
      "placement": "body footage"
    }
  }
}
