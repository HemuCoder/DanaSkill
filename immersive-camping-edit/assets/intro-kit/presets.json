          "duration": 5.8,
          "x": 0.08,
          "y": 0.15,
          "size": 0.019,
          "align": "left",
          "max_width": 0.65,
          "fade_in": 0.4,
          "fade_out": 0.4
        },
        {
          "id": "episode-title",
          "type": "text",
          "text": "{{episode_title}}",
