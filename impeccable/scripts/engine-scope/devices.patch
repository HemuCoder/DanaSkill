+//! Explicit Web device scope shared by build gates and their capture adapter.
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum WebDevice {
+    Desktop,
+    Tablet,
+    Mobile,
+}
+
+impl WebDevice {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Desktop => "desktop",
+            Self::Tablet => "tablet",
+            Self::Mobile => "mobile",
+        }
+    }
+
+    pub fn width(self) -> u32 {
+        match self {
+            Self::Desktop => 1440,
+            Self::Tablet => 768,
+            Self::Mobile => 390,
+        }
+    }
+
+    pub fn viewport(self, width: f64, height: f64) -> [u32; 2] {
+        let h = (height * self.width() as f64 / width).ceil() as u32;
+        [
+            self.width(),
+            if self == Self::Mobile { h.max(844) } else { h },
+        ]
+    }
+}
+
+pub fn parse(value: Option<&str>) -> Result<Vec<WebDevice>, String> {
+    let mut devices = Vec::new();
+    for name in value.unwrap_or("desktop").split(',') {
+        let device = match name {
+            "desktop" => WebDevice::Desktop,
+            "tablet" => WebDevice::Tablet,
+            "mobile" => WebDevice::Mobile,
+            _ => {
+                return Err(
+                    "--devices requires a comma-separated list of desktop, tablet, mobile".into(),
+                )
+            }
+        };
+        if !devices.contains(&device) {
+            devices.push(device);
+        }
+    }
+    devices.sort_by_key(|d| std::cmp::Reverse(d.width()));
+    Ok(devices)
+}
+
+pub fn from_state(state: &Value) -> Result<Vec<WebDevice>, String> {
+    let Some(value) = state.get("deviceClasses") else {
+        return parse(None);
+    };
+    let devices: Vec<WebDevice> = serde_json::from_value(value.clone())
+        .map_err(|_| "invalid deviceClasses in build state")?;
+    if devices.is_empty() {
+        return Err("deviceClasses in build state is empty".into());
+    }
+    parse(Some(
+        &devices
+            .iter()
+            .map(|d| d.name())
+            .collect::<Vec<_>>()
+            .join(","),
+    ))
+}
+
+pub fn names(devices: &[WebDevice]) -> String {
+    devices
+        .iter()
+        .map(|d| d.name())
+        .collect::<Vec<_>>()
+        .join(" and ")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn default_and_old_states_are_desktop_only() {
+        assert_eq!(parse(None).unwrap(), vec![WebDevice::Desktop]);
+        assert_eq!(from_state(&json!({})).unwrap(), vec![WebDevice::Desktop]);
+    }
+
+    #[test]
+    fn only_explicit_device_classes_are_included() {
+        assert_eq!(parse(Some("mobile")).unwrap(), vec![WebDevice::Mobile]);
+        assert_eq!(
+            parse(Some("mobile,desktop,mobile")).unwrap(),
+            vec![WebDevice::Desktop, WebDevice::Mobile]
+        );
+        assert_eq!(
+            from_state(&json!({"deviceClasses":["mobile"]})).unwrap(),
+            vec![WebDevice::Mobile]
+        );
+        assert_eq!(
+            parse(None)
+                .unwrap()
+                .iter()
+                .map(|d| d.width())
+                .collect::<Vec<_>>(),
+            vec![1440]
+        );
+    }
+
+    #[test]
+    fn invalid_scope_cannot_silently_remove_required_checks() {
+        for value in ["", "phone", "desktop,", "desktop,moble"] {
+            assert!(parse(Some(value)).is_err());
+        }
+        for state in [
+            json!({"deviceClasses":[]}),
+            json!({"deviceClasses":["phone"]}),
+            json!({"deviceClasses":null}),
+        ] {
+            assert!(from_state(&state).is_err());
+        }
+    }
+}
