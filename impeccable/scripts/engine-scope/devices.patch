@@ -0,0 +1,122 @@
+use super::*;
+use crate::web_devices::{self, WebDevice};
+
+#[test]
+fn desktop_gate_passes_without_a_mobile_capture() {
+    let ws = menu_workspace();
+    std::fs::rename(
+        ws.path.join(".impeccable/review/mobile.png"),
+        ws.path.join(".impeccable/review/desktop.png"),
+    )
+    .unwrap();
+    let mut state = json!({"comp":"comp.png","phases":{}});
+    let gate = gate_responsive(&ws.io(), &mut state, 0.1, "diff", None);
+    assert!(gate.ok, "{:?}", gate.reasons);
+    state["deviceClasses"] = json!(["desktop", "mobile"]);
+    let gate = gate_responsive(&ws.io(), &mut state, 0.1, "diff", None);
+    assert!(!gate.ok);
+    assert!(gate
+        .reasons
+        .iter()
+        .any(|r| r.contains("no .impeccable/review/mobile.png")));
+}
+
+#[test]
+fn mobile_only_gate_does_not_require_desktop() {
+    let ws = menu_workspace();
+    let mut state = json!({"comp":"comp.png","phases":{},"deviceClasses":["mobile"]});
+    let gate = gate_responsive(&ws.io(), &mut state, 0.1, "diff", None);
+    assert!(gate.ok, "{:?}", gate.reasons);
+    assert!(gate.summary.unwrap().starts_with("mobile "));
+}
+
+#[test]
+fn tablet_only_gate_does_not_require_phone_or_desktop() {
+    let ws = menu_workspace();
+    std::fs::rename(
+        ws.path.join(".impeccable/review/mobile.png"),
+        ws.path.join(".impeccable/review/tablet.png"),
+    )
+    .unwrap();
+    let mut state = json!({"comp":"comp.png","phases":{},"deviceClasses":["tablet"]});
+    let gate = gate_responsive(&ws.io(), &mut state, 0.1, "diff", None);
+    assert!(gate.ok, "{:?}", gate.reasons);
+    assert!(gate.summary.unwrap().starts_with("tablet "));
+}
+
+#[test]
+fn start_persists_only_the_requested_devices() {
+    for value in [None, Some("mobile"), Some("desktop,tablet,mobile")] {
+        let ws = Workspace::new();
+        let mut io = ws.io();
+        let mut args = vec!["start", "--direction", "test"];
+        if let Some(value) = value {
+            args.extend(["--devices", value]);
+        }
+        assert_eq!(
+            run(
+                &args.into_iter().map(String::from).collect::<Vec<_>>(),
+                &mut io,
+                &no_organic_scan
+            ),
+            0
+        );
+        let state = load_state(&io).unwrap();
+        assert_eq!(
+            web_devices::from_state(&state).unwrap(),
+            web_devices::parse(value).unwrap()
+        );
+    }
+}
+
+struct ScopedRenderer {
+    devices: Vec<WebDevice>,
+    png: Vec<u8>,
+}
+impl EntryRenderer for ScopedRenderer {
+    fn capture_entry(&self, request: &EntryRequest) -> Result<Box<dyn CapturedEntry>, String> {
+        assert_eq!(request.devices, self.devices);
+        let frames = request
+            .devices
+            .iter()
+            .map(|d| crate::entry_capture::FrameEvidence {
+                name: d.name().into(),
+                png: self.png.clone(),
+                regions: vec![],
+            })
+            .collect();
+        Ok(Box::new(ReviewedCapture(
+            crate::entry_capture::EntryEvidence {
+                report: json!({}),
+                frames,
+            },
+            None,
+        )))
+    }
+}
+
+#[test]
+fn native_capture_requests_and_retains_only_scoped_frames() {
+    for value in ["desktop", "mobile", "tablet", "desktop,mobile"] {
+        let ws = menu_workspace();
+        let devices = web_devices::parse(Some(value)).unwrap();
+        let mut state = json!({"comp":"comp.png","phases":{},"capturePolicy":"native-html-v1","deviceClasses":devices});
+        let renderer = ScopedRenderer {
+            devices: devices.clone(),
+            png: std::fs::read(ws.path.join("comp.png")).unwrap(),
+        };
+        let gate = gate_responsive(&ws.io(), &mut state, 0.1, "diff", Some(&renderer));
+        assert!(gate.ok, "{:?}", gate.reasons);
+        for device in [WebDevice::Desktop, WebDevice::Tablet, WebDevice::Mobile] {
+            assert_eq!(
+                ws.path
+                    .join(format!(
+                        ".impeccable/review/native/responsive/{}.png",
+                        device.name()
+                    ))
+                    .exists(),
+                devices.contains(&device)
+            );
+        }
+    }
+}
